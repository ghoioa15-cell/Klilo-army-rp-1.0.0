		local color = espColor(plr)
		do
			local h2 = char and char:FindFirstChildOfClass("Humanoid")
			local cHp = h2 and h2.Health
			local pv = lastHealth[plr]
			if pv and pv > 0 and cHp and cHp <= 0 then
				local now = os.clock()
				if now - lastKillSoundAt > 0.15 then lastKillSoundAt = now playKillSound() end
			end
			if cHp then lastHealth[plr] = cHp end
		end
		if espState.Enabled and alive then
			if not o.highlight or o.highlight.Parent ~= char then
				if o.highlight then o.highlight:Destroy() end
