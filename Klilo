table.insert(espConnections, RunService.RenderStepped:Connect(function()
	local cam = Workspace.CurrentCamera
	if not cam then return end

	local any2D = espState.Name or espState.Distance or espState.Box
		or espState.Faction or espState.Health or espState.Tool

	for plr, o in pairs(espObjects) do
		local char, hrp, hum = getLiveParts(plr)
		local alive = char ~= nil
		local color = espColor(plr)

		do
			local hum2 = char and char:FindFirstChildOfClass("Humanoid")
			local currentHp = hum2 and hum2.Health
			local prev = lastHealth[plr]
			if prev and prev > 0 and currentHp and currentHp <= 0 then
				local now = os.clock()
				if now - lastKillSoundAt > 0.15 then
					lastKillSoundAt = now
					playKillSound()
				end
			end
			if currentHp ~= nil then
				lastHealth[plr] = currentHp
			end
		end

		if espState.Enabled and alive then
			if not o.highlight or o.highlight.Parent ~= char then
				if o.highlight then
					o.highlight:Destroy()
				end
				o.highlight = create("Highlight", {
					Name = "KiloESP",
					FillColor = color,
					FillTransparency = 0.65,
					OutlineColor = C.Text,
					OutlineTransparency = 0,
					DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
				}, char)
			end
			o.highlight.FillColor = color
		elseif o.highlight then
			o.highlight:Destroy()
			o.highlight = nil
		end

		local draw = false
		if any2D and alive then
			local top = cam:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.8, 0))
			local bottom = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.2, 0))

			if top.Z > 0 and bottom.Z > 0 then
				draw = true
				local height = math.max(math.abs(bottom.Y - top.Y), 10)
				local width = height * 0.55
				local cx = (top.X + bottom.X) / 2

				o.holder.Position = UDim2.fromOffset(math.floor(cx - width / 2), math.floor(top.Y))
				o.holder.Size = UDim2.fromOffset(math.floor(width), math.floor(height))

				o.outline.Visible = espState.Box
				o.box.Visible = espState.Box
				o.boxStroke.Color = color

				o.nameLbl.Visible = espState.Name
				o.nameLbl.Text = plr.DisplayName
				o.nameLbl.Position = UDim2.new(0.5, 0, 0, -4)

				o.factionLbl.Visible = espState.Faction
				o.factionLbl.Text = plr.Team and plr.Team.Name or "Без фракции"
				o.factionLbl.TextColor3 = color
				o.factionLbl.Position = UDim2.new(0.5, 0, 0, espState.Name and -20 or -4)

				o.healthBg.Visible = espState.Health
				o.hpPill.Visible = espState.Health
				if espState.Health and hum then
					local maxH = math.max(hum.MaxHealth, 1)
					local ratio = math.clamp(hum.Health / maxH, 0, 1)

					o.healthFill.Size = UDim2.fromScale(1, ratio)

					local r, g
					if ratio > 0.5 then
						r = (1 - ratio) * 1.6
						g = 0.62
					else
						r = 0.85
						g = ratio * 1.2
					end
					local barColor = Color3.new(r, g, 0.32)
					o.healthFill.BackgroundColor3 = barColor

					o.healthGrad.Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, barColor:Lerp(Color3.new(0, 0, 0), 0.35)),
						ColorSequenceKeypoint.new(1, barColor:Lerp(Color3.new(1, 1, 1), 0.20)),
					})

					o.hpLbl.Text = tostring(math.floor(hum.Health + 0.5))
					o.hpLbl.TextColor3 = barColor:Lerp(Color3.new(1, 1, 1), 0.5)
				end

				o.distLbl.Visible = espState.Distance
				local dist = (cam.CFrame.Position - hrp.Position).Magnitude
				o.distLbl.Text = string.format("[%dm]", math.floor(dist))
				o.distLbl.Position = UDim2.new(0.5, 0, 1, 4)

				local tool = char:FindFirstChildOfClass("Tool")
				o.toolLbl.Visible = espState.Tool and tool ~= nil
				if tool then
					o.toolLbl.Text = tool.Name
					o.toolLbl.TextColor3 = color
					o.toolLbl.Position = UDim2.new(0.5, 0, 1, espState.Distance and 22 or 4)
				end
			end
		end
		o.holder.Visible = draw
	end
end))

local function espCleanup()
	for _, c in ipairs(espConnections) do
		c:Disconnect()
	end
	table.clear(espConnections)
	for plr in pairs(espObjects) do
		removeEsp(plr)
	end
	espGui:Destroy()
end

