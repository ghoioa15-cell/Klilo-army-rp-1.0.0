-- Свернуть / развернуть / закрыть
--------------------------------------------------------------------
local minimized = false
local maximized = false
local busy = false

local function minimize()
	if minimized or busy then return end
	busy = true

	local t = tween(windowScale, 0.25, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	t.Completed:Wait()
	window.Visible = false
	minimized = true

	pill.Position = UDim2.new(0.5, 0, 0, PILL_HIDDEN_Y)
	pill.Visible = true
	tween(pill, 0.35, { Position = UDim2.new(0.5, 0, 0, PILL_SHOWN_Y) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	busy = false
end

local function restore()
	if not minimized or busy then return end
	busy = true

	local p = pill.Position
	local t = tween(
		pill, 0.25,
		{ Position = UDim2.new(p.X.Scale, p.X.Offset, 0, PILL_HIDDEN_Y) },
		Enum.EasingStyle.Quad, Enum.EasingDirection.In
	)
	t.Completed:Wait()
	pill.Visible = false

	windowScale.Scale = 0
	window.Visible = true
	minimized = false
	tween(windowScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	busy = false
end

local function toggleMaximize()
	if minimized or busy then return end
	maximized = not maximized

	local size = normalSize
	if maximized then
		local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		size = UDim2.fromOffset(vp.X * 0.94, vp.Y * 0.88)
	end

	tween(window, 0.3, { Size = size, Position = centerPos }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
end

local function closeUI()
	if busy then return end
	busy = true
	local t = tween(windowScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	t.Completed:Wait()
	fbRestore()
	espCleanup()
	aimbotCleanup()
	playerCleanup()
	if skyInstance then skyInstance:Destroy() end
	gui:Destroy()
	soundFolder:Destroy()
end

