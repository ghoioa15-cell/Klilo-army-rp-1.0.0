	task.wait(0.2)

	tween(backdrop, 0.35, { BackgroundTransparency = 1 })
	tween(loadCard, 0.35, { BackgroundTransparency = 1 })
	tween(loadCardStroke, 0.35, { Transparency = 1 })
	tween(loadLogo, 0.35, { ImageTransparency = 1 })
	tween(loadLabel, 0.35, { TextTransparency = 1 })
	tween(loadBarBg, 0.35, { BackgroundTransparency = 1 })

	task.wait(0.4)
	loadingGui:Destroy()

	window.Visible = true
	tween(windowScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end)
