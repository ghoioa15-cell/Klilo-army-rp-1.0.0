local oldEsp = playerGui:FindFirstChild("KiloArmyRP_ESP")
if oldEsp then oldEsp:Destroy() end

local espGui = create("ScreenGui", {
	Name = "KiloArmyRP_ESP",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 10,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, playerGui)

local espState = {
	Enabled = false,
	Name = false,
	Distance = false,
	Box = false,
	Faction = false,
	Health = false,
	Tool = false,
}

local espObjects = {}
local espConnections = {}
local BLACK = Color3.fromRGB(0, 0, 0)

local lastKillSoundAt = 0
local lastHealth = {}

local function espColor(plr)
	if plr.Team then
		return plr.Team.TeamColor.Color
	end
	return C.Text
end

local function getLiveParts(plr)
	local char = plr.Character
	if not char or not char:IsDescendantOf(Workspace) then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or not hrp:IsDescendantOf(Workspace) then return nil end
	if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then return nil end
	return char, hrp, hum
end

local function removeEsp(plr)
	local o = espObjects[plr]
	if not o then return end
	for _, c in ipairs(o.conns or {}) do
		c:Disconnect()
	end
	if o.highlight then
		o.highlight:Destroy()
	end
	o.holder:Destroy()
	espObjects[plr] = nil
	lastHealth[plr] = nil
end

local function createEsp(plr)
	if plr == player or espObjects[plr] then return end

	local holder = create("Frame", {
		Name = plr.Name,
		BackgroundTransparency = 1,
		Visible = false,
	}, espGui)

	local outline = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
	}, holder)
	stroke(outline, BLACK, 3)

	local box = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
	}, holder)
	local boxStroke = stroke(box, C.Text, 1)

	local function makeLabel(font, size, anchor, pos)
		return create("TextLabel", {
			AnchorPoint = anchor,
			Position = pos,
			Size = UDim2.fromOffset(200, size + 2),
			BackgroundTransparency = 1,
			TextColor3 = C.Text,
			Font = font,
			TextSize = size,
			TextStrokeColor3 = BLACK,
			TextStrokeTransparency = 0.3,
			Visible = false,
		}, holder)
	end

	local nameLbl = makeLabel(Enum.Font.GothamBold, 13, Vector2.new(0.5, 1), UDim2.new(0.5, 0, 0, -4))
	local factionLbl = makeLabel(Enum.Font.GothamMedium, 12, Vector2.new(0.5, 1), UDim2.new(0.5, 0, 0, -4))
	local distLbl = makeLabel(Enum.Font.GothamMedium, 12, Vector2.new(0.5, 0), UDim2.new(0.5, 0, 1, 4))
	local toolLbl = makeLabel(Enum.Font.GothamMedium, 12, Vector2.new(0.5, 0), UDim2.new(0.5, 0, 1, 22))

	local healthBg = create("Frame", {
		Name = "HealthBg",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0, -5, 0, 0),
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		Visible = false,
	}, holder)
	corner(healthBg, 2)

	local healthFill = create("Frame", {
		Name = "HealthFill",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(80, 200, 100),
		BorderSizePixel = 0,
	}, healthBg)
	corner(healthFill, 2)

	local healthGrad = create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 150, 70)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 220, 140)),
		}),
	}, healthFill)

	local hpPill = create("Frame", {
		Name = "HpPill",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0, -10, 0, 0),
		Size = UDim2.fromOffset(24, 14),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Visible = false,
	}, holder)
	corner(hpPill, 3)

	local hpLbl = create("TextLabel", {
		Name = "HpLabel",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(180, 240, 200),
		Font = Enum.Font.GothamBold,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, hpPill)

	espObjects[plr] = {
		holder = holder,
		outline = outline,
		box = box,
		boxStroke = boxStroke,
		nameLbl = nameLbl,
		factionLbl = factionLbl,
		distLbl = distLbl,
		toolLbl = toolLbl,
		healthBg = healthBg,
		healthFill = healthFill,
		healthGrad = healthGrad,
		hpPill = hpPill,
		hpLbl = hpLbl,
		highlight = nil,
		conns = {},
	}

	local function reset()
		local o = espObjects[plr]
		if not o then return end
		if o.highlight then
			o.highlight:Destroy()
			o.highlight = nil
		end
		o.holder.Visible = false
	end
	local o = espObjects[plr]
	table.insert(o.conns, plr.CharacterRemoving:Connect(reset))
	table.insert(o.conns, plr:GetPropertyChangedSignal("Team"):Connect(reset))
end

