local AIM_SMOOTHNESS, SWITCH_RATIO = 1, 0.6
local oldAim = playerGui:FindFirstChild("KiloArmyRP_Aimbot") if oldAim then oldAim:Destroy() end
local aimState = {Enabled = false, Mode = 1, Part = "Head", Diameter = 150, Color = Color3.fromRGB(255,255,255)}
local aimConnections = {}
local aimGui = create("ScreenGui", {Name = "KiloArmyRP_Aimbot", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 9, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, playerGui)
local aimCircle = create("Frame", {Name = "Circle", AnchorPoint = Vector2.new(0.5,0.5), Position = UDim2.fromScale(0.5,0.5), Size = UDim2.fromOffset(aimState.Diameter, aimState.Diameter), BackgroundTransparency = 1, Visible = false}, aimGui)
corner(aimCircle, 999)
local aimCircleStroke = stroke(aimCircle, aimState.Color, 2)
local function setCircleSize(d) aimState.Diameter = d aimCircle.Size = UDim2.fromOffset(d, d) end
local function setCircleColor(c) aimState.Color = c aimCircleStroke.Color = c end
local currentTarget = nil
local defaultFov = Workspace.CurrentCamera and Workspace.CurrentCamera.FieldOfView or 70
local fovOverride = nil
local function hasWeapon() local c = player.Character return c ~= nil and c:FindFirstChildOfClass("Tool") ~= nil end
local function isAiming(cam)
	if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return true end
	return cam.FieldOfView < (fovOverride or defaultFov) - 3
end
local function distToCenter(cam, part, center)
	local p = cam:WorldToViewportPoint(part.Position)
	if p.Z <= 0 then return nil end
	return (Vector2.new(p.X, p.Y) - center).Magnitude
end
local AIM_PART_LISTS = {
	Head = {"Head"}, Torso = {"UpperTorso", "Torso"},
	Arms = {"RightUpperArm","LeftUpperArm","RightLowerArm","LeftLowerArm","Right Arm","Left Arm"},
	Legs = {"RightUpperLeg","LeftUpperLeg","RightLowerLeg","LeftLowerLeg","Right Leg","Left Leg"},
}
local function getAimPart(plr, cam, center)
	local char, hrp = getLiveParts(plr) if not char then return nil end
	local best, bd = nil, nil
	for _, n in ipairs(AIM_PART_LISTS[aimState.Part] or AIM_PART_LISTS.Head) do
		local p = char:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			local d = distToCenter(cam, p, center)
			if d and (not bd or d < bd) then best, bd = p, d end
		end
	end
	return best or hrp
end
pcall(function() RunService:UnbindFromRenderStep("KiloArmyRP_Aimbot") end)
RunService:BindToRenderStep("KiloArmyRP_Aimbot", Enum.RenderPriority.Camera.Value + 1, function()
	aimCircle.Visible = aimState.Enabled
	local cam = Workspace.CurrentCamera
	if not aimState.Enabled or not cam then currentTarget = nil return end
	local active = hasWeapon()
	if active and aimState.Mode == 2 then active = isAiming(cam) end
	if not active then currentTarget = nil return end
	local center = cam.ViewportSize / 2
	local radius = aimState.Diameter / 2
	local cd = nil
	if currentTarget then
		local p = getAimPart(currentTarget, cam, center)
		cd = p and distToCenter(cam, p, center) or nil
		if not cd or cd > radius then currentTarget = nil cd = nil end
	end
	local bp, bd = nil, nil
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local p = getAimPart(plr, cam, center)
			if p then
				local d = distToCenter(cam, p, center)
				if d and d <= radius and (not bd or d < bd) then bp, bd = plr, d end
			end
		end
	end
	if bp and bp ~= currentTarget then
		if not currentTarget or bd < cd * SWITCH_RATIO then currentTarget = bp end
	end
	if currentTarget then
		local p = getAimPart(currentTarget, cam, center)
		if p then
			local goal = CFrame.lookAt(cam.CFrame.Position, p.Position)
			cam.CFrame = cam.CFrame:Lerp(goal, AIM_SMOOTHNESS)
		end
	end
end)
local function aimbotCleanup()
	pcall(function() RunService:UnbindFromRenderStep("KiloArmyRP_Aimbot") end)
	for _, c in ipairs(aimConnections) do c:Disconnect() end
	table.clear(aimConnections) aimGui:Destroy()
end

