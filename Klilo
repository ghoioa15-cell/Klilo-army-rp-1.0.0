local TRACK_OFF = Color3.fromRGB(55, 55, 55)
local KNOB_ON = Color3.fromRGB(10, 10, 10)

local function addToggle(order, titleText, descText, key, parent, state)
	state = state or espState
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundColor3 = C.Item,
		BorderSizePixel = 0,
		LayoutOrder = order,
	}, parent or visualsPage)
	corner(row, 10)

	create("TextLabel", {
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.new(1, -90, 0, 20),
		BackgroundTransparency = 1,
		Text = titleText,
		TextColor3 = C.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	create("TextLabel", {
		Position = UDim2.fromOffset(14, 32),
		Size = UDim2.new(1, -90, 0, 18),
		BackgroundTransparency = 1,
		Text = descText,
		TextColor3 = C.SubText,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, row)

	local track = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(46, 26),
		BackgroundColor3 = TRACK_OFF,
		Text = "",
		AutoButtonColor = false,
	}, row)
	corner(track, 13)

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = C.Text,
		BorderSizePixel = 0,
	}, track)
	corner(knob, 10)

	local function render()
		local on = state[key]
		tween(track, 0.15, { BackgroundColor3 = on and C.Text or TRACK_OFF })
		tween(knob, 0.15, {
			Position = on and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = on and KNOB_ON or C.Text,
		})
	end

	track.MouseButton1Click:Connect(function()
		state[key] = not state[key]
		render()
	end)
end

