local function addSlider(order, titleText, minV, maxV, startV, onChange, parent)
	local page = parent or combatPage
	local card = create("Frame", {Size = UDim2.new(1,0,0,70), BackgroundColor3 = C.Item, BorderSizePixel = 0, LayoutOrder = order}, page)
	corner(card, 10)
	create("TextLabel", {Position = UDim2.fromOffset(14,10), Size = UDim2.new(1,-90,0,20), BackgroundTransparency = 1, Text = titleText, TextColor3 = C.Text, Font = Enum.Font.GothamBold, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left}, card)
	local vLbl = create("TextLabel", {AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-14,0,10), Size = UDim2.fromOffset(70,20), BackgroundTransparency = 1, Text = tostring(startV), TextColor3 = C.SubText, Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right}, card)
	local hit = create("TextButton", {Position = UDim2.fromOffset(14,38), Size = UDim2.new(1,-28,0,24), BackgroundTransparency = 1, Text = "", AutoButtonColor = false}, card)
	local bar = create("Frame", {AnchorPoint = Vector2.new(0,0.5), Position = UDim2.fromScale(0,0.5), Size = UDim2.new(1,0,0,6), BackgroundColor3 = TRACK_OFF, BorderSizePixel = 0}, hit)
	corner(bar, 3)
	local fill = create("Frame", {Size = UDim2.fromScale(0,1), BackgroundColor3 = C.Text, BorderSizePixel = 0}, bar)
	corner(fill, 3)
	local knob = create("Frame", {AnchorPoint = Vector2.new(0.5,0.5), Position = UDim2.fromScale(0,0.5), Size = UDim2.fromOffset(16,16), BackgroundColor3 = C.Text, BorderSizePixel = 0, ZIndex = 2}, hit)
	corner(knob, 8)
	local function setA(a)
		a = math.clamp(a, 0, 1)
		local v = math.floor(minV + (maxV - minV) * a + 0.5)
		fill.Size = UDim2.fromScale(a, 1) knob.Position = UDim2.fromScale(a, 0.5)
		vLbl.Text = tostring(v) onChange(v)
	end
	setA((startV - minV) / math.max(maxV - minV, 1))
	local drag = false
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			drag = true page.ScrollingEnabled = false
			setA((i.Position.X - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1))
			i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then drag = false page.ScrollingEnabled = true end end)
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			setA((i.Position.X - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1))
		end
	end)
end

