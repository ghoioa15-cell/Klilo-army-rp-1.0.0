end)

RunService:BindToRenderStep("KiloArmyRP_Aimbot", Enum.RenderPriority.Camera.Value + 1, function()
	aimCircle.Visible = aimState.Enabled

	local cam = Workspace.CurrentCamera
	if not aimState.Enabled or not cam then
		currentTarget = nil
		return
	end

	local active = hasWeapon()
	if active and aimState.Mode == 2 then
		active = isAiming(cam)
	end
	if not active then
		currentTarget = nil
		return
	end

	local center = cam.ViewportSize / 2
	local radius = aimState.Diameter / 2

	local currentDist = nil
	if currentTarget then
		local part = getAimPart(currentTarget, cam, center)
		currentDist = part and distToCenter(cam, part, center) or nil
		if not currentDist or currentDist > radius then
			currentTarget = nil
			currentDist = nil
		end
	end

	local bestPlr, bestDist = nil, nil
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local part = getAimPart(plr, cam, center)
			if part then
				local d = distToCenter(cam, part, center)
				if d and d <= radius and (not bestDist or d < bestDist) then
					bestPlr, bestDist = plr, d
				end
			end
		end
	end

	if bestPlr and bestPlr ~= currentTarget then
		if not currentTarget or bestDist < currentDist * SWITCH_RATIO then
			currentTarget = bestPlr
		end
	end

	if currentTarget then
		local part = getAimPart(currentTarget, cam, center)
		if part then
			local goal = CFrame.lookAt(cam.CFrame.Position, part.Position)
			cam.CFrame = cam.CFrame:Lerp(goal, AIM_SMOOTHNESS)
		end
	end
end)

local function aimbotCleanup()
	pcall(function()
		RunService:UnbindFromRenderStep("KiloArmyRP_Aimbot")
	end)
	for _, c in ipairs(aimConnections) do
		c:Disconnect()
	end
	table.clear(aimConnections)
	aimGui:Destroy()
end

