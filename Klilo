				local w = h * 0.55
				local cx = (top.X + bot.X) / 2
				o.holder.Position = UDim2.fromOffset(math.floor(cx - w/2), math.floor(top.Y))
				o.holder.Size = UDim2.fromOffset(math.floor(w), math.floor(h))
