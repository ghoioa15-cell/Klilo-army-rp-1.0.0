local currentTarget = nil
local defaultFov = Workspace.CurrentCamera and Workspace.CurrentCamera.FieldOfView or 70
local fovOverride = nil

local function hasWeapon()
	local char = player.Character
	return char ~= nil and char:FindFirstChildOfClass("Tool") ~= nil
end

local function isAiming(cam)
	if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		return true
	end
	return cam.FieldOfView < (fovOverride or defaultFov) - 3
end

local function distToCenter(cam, part, center)
	local pos = cam:WorldToViewportPoint(part.Position)
	if pos.Z <= 0 then return nil end
	return (Vector2.new(pos.X, pos.Y) - center).Magnitude
end

local AIM_PART_LISTS = {
	Head = { "Head" },
	Torso = { "UpperTorso", "Torso" },
	Arms = {
		"RightUpperArm", "LeftUpperArm", "RightLowerArm", "LeftLowerArm",
		"Right Arm", "Left Arm",
	},
	Legs = {
		"RightUpperLeg", "LeftUpperLeg", "RightLowerLeg", "LeftLowerLeg",
		"Right Leg", "Left Leg",
	},
}

local function getAimPart(plr, cam, center)
	local char, hrp = getLiveParts(plr)
	if not char then return nil end

	local best, bestDist = nil, nil
	for _, name in ipairs(AIM_PART_LISTS[aimState.Part] or AIM_PART_LISTS.Head) do
		local part = char:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			local d = distToCenter(cam, part, center)
			if d and (not bestDist or d < bestDist) then
				best, bestDist = part, d
			end
		end
	end
	return best or hrp
end

pcall(function()
