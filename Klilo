local playerConns = {}

local moveControls = nil
task.spawn(function()
	local scripts = player:WaitForChild("PlayerScripts", 10)
	local module = scripts and scripts:WaitForChild("PlayerModule", 10)
	if module then
		local ok, controls = pcall(function()
			return require(module):GetControls()
		end)
		if ok then
			moveControls = controls
		end
	end
end)

local function getMyParts()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then
		return char, hum, root
	end
	return nil
end

local wasFlying = false

table.insert(playerConns, RunService.RenderStepped:Connect(function(dt)
	local cam = Workspace.CurrentCamera
	local char, hum, root = getMyParts()
	if not char or not cam then return end

	if playerState.Fly then
		wasFlying = true
		hum.PlatformStand = true

		local move = Vector3.zero
		if moveControls then
			local v = moveControls:GetMoveVector()
			move = cam.CFrame.RightVector * v.X - cam.CFrame.LookVector * v.Z
		else
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.yAxis end

		if move.Magnitude > 0.05 then
			root.AssemblyLinearVelocity = move.Unit * playerVals.FlySpeed
		else
			root.AssemblyLinearVelocity = Vector3.zero
		end
	elseif wasFlying then
		wasFlying = false
		hum.PlatformStand = false
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end

	if playerState.Speed and not playerState.Fly and hum.MoveDirection.Magnitude > 0.1 then
		local extra = math.max(playerVals.Speed - hum.WalkSpeed, 0)
		root.CFrame = root.CFrame + hum.MoveDirection * extra * dt
	end
end))

table.insert(playerConns, RunService.Stepped:Connect(function()
	if not playerState.Noclip then return end
	local char = player.Character
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
end))

local lastJumpBoost = 0
local lastInfJump = 0

table.insert(playerConns, UserInputService.JumpRequest:Connect(function()
	local char, hum, root = getMyParts()
	if not char then return end

	local airborne = hum.FloorMaterial == Enum.Material.Air
	local now = os.clock()

	if airborne then
		if playerState.InfJump and now - lastInfJump >= playerVals.InfCooldown then
			lastInfJump = now
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, playerVals.InfPower, v.Z)
		end
	elseif playerState.Jump and now - lastJumpBoost > 0.25 then
		lastJumpBoost = now
		task.defer(function()
			if root.Parent and playerState.Jump then
				local v = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(v.X, playerVals.JumpPower, v.Z)
			end
		end)
	end
end))

local originalFov = nil

table.insert(playerConns, RunService.RenderStepped:Connect(function()
	local cam = Workspace.CurrentCamera
	if not cam then return end

	if playerState.Fov then
		fovOverride = playerVals.Fov
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
		if not originalFov then
			originalFov = cam.FieldOfView
		end
		cam.FieldOfView = playerVals.Fov
	elseif originalFov then
		cam.FieldOfView = originalFov
		originalFov = nil
		fovOverride = nil
	end
end))

local function playerCleanup()
	for _, c in ipairs(playerConns) do
		c:Disconnect()
	end
	table.clear(playerConns)
	playerState.Fly = false
	local cam = Workspace.CurrentCamera
	if cam and originalFov then
		cam.FieldOfView = originalFov
		originalFov = nil
		fovOverride = nil
	end
	local _, hum = getMyParts()
	if hum then
		hum.PlatformStand = false
	end
end

