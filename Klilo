local skyInstance = nil
local currentSky = 1

local function applySkybox(index)
	currentSky = index
	if skyInstance then
		skyInstance:Destroy()
		skyInstance = nil
	end
	local preset = SKYBOXES[index]
	if not preset or not preset.ids then return end
	skyInstance = create("Sky", {
		Name = "KiloSky",
		SkyboxUp = preset.ids.Up,
		SkyboxDn = preset.ids.Dn,
		SkyboxFt = preset.ids.Ft,
		SkyboxBk = preset.ids.Bk,
		SkyboxLf = preset.ids.Lf,
		SkyboxRt = preset.ids.Rt,
		StarCount = 3000,
	}, Lighting)
end

addSectionLabel(visualsPage, 14, "Skybox")

do
	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundColor3 = C.Item,
