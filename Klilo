local function espColor(plr) if plr.Team then return plr.Team.TeamColor.Color end return C.Text end
local function getLiveParts(plr)
	local c = plr.Character
	if not c or not c:IsDescendantOf(Workspace) then return nil end
	local h = c:FindFirstChildOfClass("Humanoid")
	local r = c:FindFirstChild("HumanoidRootPart")
	if not h or not r or not r:IsDescendantOf(Workspace) then return nil end
	if h.Health <= 0 or h:GetState() == Enum.HumanoidStateType.Dead then return nil end
	return c, r, h
end

local function removeEsp(plr)
	local o = espObjects[plr] if not o then return end
	for _, c in ipairs(o.conns or {}) do c:Disconnect() end
