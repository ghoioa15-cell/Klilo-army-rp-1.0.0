					local r = math.clamp(hum.Health / mh, 0, 1)
					o.hFill.Size = UDim2.fromScale(1, r)
					local rr, gg
					if r > 0.5 then rr = (1 - r) * 1.6 gg = 0.62 else rr = 0.85 gg = r * 1.2 end
					local bC = Color3.new(rr, gg, 0.32)
					o.hFill.BackgroundColor3 = bC
					o.hGrad.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, bC:Lerp(Color3.new(0,0,0), 0.35)), ColorSequenceKeypoint.new(1, bC:Lerp(Color3.new(1,1,1), 0.2))})
					o.hpLbl.Text = tostring(math.floor(hum.Health + 0.5)) o.hpLbl.TextColor3 = bC:Lerp(Color3.new(1,1,1), 0.5)
				end
				o.distLbl.Visible = espState.Distance
				local d = (cam.CFrame.Position - hrp.Position).Magnitude
				o.distLbl.Text = string.format("[%dm]", math.floor(d)) o.distLbl.Position = UDim2.new(0.5,0,1,4)
